{
  "expo": {
    "name": "DealRadar",
    "slug": "dealradar",
    "scheme": "dealradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14120e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tanush.dealradar",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.tanush.dealradar",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#d9480f",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dealradar.ggnhome.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#14120e"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d9480f",
          "defaultChannel": "deal-alerts"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_search": {
              "foregroundImage": "./assets/shortcut-search.png",
              "backgroundColor": "#ffffff"
            },
            "shortcut_saved": {
              "foregroundImage": "./assets/shortcut-saved.png",
              "backgroundColor": "#ffffff"
            },
            "shortcut_checkprice": {
              "foregroundImage": "./assets/shortcut-checkprice.png",
              "backgroundColor": "#ffffff"
            }
          }
        }
      ],
      "./plugins/withAbiFilter"
    ],
    "extra": {
      "defaultServerUrl": "https://dealradar.ggnhome.com",
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "9adf154c-26d2-4c82-9981-cb73088dab99"
      }
    },
    "owner": "tanushhh18",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9adf154c-26d2-4c82-9981-cb73088dab99",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
