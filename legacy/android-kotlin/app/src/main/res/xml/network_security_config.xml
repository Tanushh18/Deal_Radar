<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted because the whole point of this build is pointing the
  app at a DealRadar server you run yourself — an emulator host (10.0.2.2), a
  laptop on the same Wi-Fi (192.168.x.x), or a LAN box. Those are plain http
  and their addresses are not known ahead of time, so they cannot be listed as
  domain exceptions. An https:// server URL still gets full TLS validation.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
