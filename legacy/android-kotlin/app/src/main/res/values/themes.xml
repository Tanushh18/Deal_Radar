<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DealRadar" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Shown for the fraction of a second before the WebView paints, so the
         launch never flashes white against the app's dark UI. -->
    <style name="Theme.DealRadar.Splash" parent="Theme.DealRadar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
