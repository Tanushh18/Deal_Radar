# ============================================================
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- Telegram (required) ---
# Get these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Security (required in production) ---
# Any long random string. Signs cookies AND derives the key that encrypts
# stored Telegram sessions — changing it forces every user to sign in again.
# Generate: make secret
SECRET_KEY=
ADMIN_TOKEN=

# --- Google Sheets (optional; app runs SQLite-only without it) ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=DealRadar App
# Base64 of the service-account JSON (best for hosting — no newline problems):
#   macOS:  base64 -i service-account.json | tr -d '\n'
#   Linux:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_B64=
# ...or paste the raw JSON instead (single line):
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Deployment ---
# Leave empty for local/Android testing. Set to your https:// URL in production:
# the session cookie is only marked Secure when this starts with https://.
PUBLIC_URL=

# --- Ingestion tuning ---
POLL_INTERVAL_SECONDS=120     # how often to poll channels
DEAL_TTL_HOURS=96             # 4 days; live links get extended past this
BACKFILL_LIMIT=120            # messages pulled on a channel's first fetch
INCREMENTAL_LIMIT=60          # messages pulled per poll thereafter
MAX_CHANNELS_PER_USER=40
LIVENESS_CHECK=true           # probe deal links, retire dead/out-of-stock ones
LIVENESS_BATCH=40

# --- Keepalive ---
KEEPALIVE_ENABLED=false
KEEPALIVE_SECONDS=600

# --- Local ---
DB_PATH=data/deals.db
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# --- Public mode (optional): no user sign-in; the server's own account reads
# these public channels. Generate the session with: python tools/make_session.py
TELEGRAM_SESSION=
PUBLIC_CHANNELS=
