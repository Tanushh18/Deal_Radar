# ============================================================
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- Telegram (required) ---
# Get these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- Security (required in production) ---
# Any long random string. Signs cookies AND derives the key that encrypts
# stored Telegram sessions — changing it forces every user to sign in again.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=another-random-string-for-admin-endpoints

# --- Google Sheets (optional; app runs SQLite-only without it) ---
GOOGLE_SHEET_ID=1AbC...the-id-from-your-sheet-url
GOOGLE_SHEET_NAME=Telegram Deals
# Base64 of the service-account JSON (best for Render — no newline problems):
#   macOS:  base64 -i service-account.json | tr -d '\n'
#   Linux:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_B64=
# ...or paste the raw JSON instead (single line):
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Deployment ---
# Your public URL. Enables the self-ping keepalive and secure cookies.
PUBLIC_URL=https://your-app.onrender.com

# --- Ingestion tuning ---
POLL_INTERVAL_SECONDS=300     # how often to poll channels
DEAL_TTL_HOURS=96             # 4 days; live links get extended past this
BACKFILL_LIMIT=120            # messages pulled on a channel's first fetch
INCREMENTAL_LIMIT=60          # messages pulled per poll thereafter
MAX_CHANNELS_PER_USER=40
LIVENESS_CHECK=true           # probe deal links, retire dead/out-of-stock ones
LIVENESS_BATCH=40

# --- Keepalive ---
KEEPALIVE_ENABLED=true
KEEPALIVE_SECONDS=600

# --- Local ---
DB_PATH=data/deals.db
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
