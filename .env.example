# ============================================================
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- Telegram (required) ---
# Get these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Security (required in production) ---
# Any long random string. Signs cookies AND derives the key that encrypts
# stored Telegram sessions — changing it forces every user to sign in again.
# Generate: make secret
SECRET_KEY=
ADMIN_TOKEN=

# --- MongoDB (optional; app runs SQLite/Turso-only without it) ---
# Durable store for users, channels, channel-tracking links, watchlists and
# admin settings — deals/price history/price alerts always live in Turso.
# mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=dealradar

# --- Deployment ---
# Leave empty for local/Android testing. Set to your https:// URL in production:
# the session cookie is only marked Secure when this starts with https://.
PUBLIC_URL=

# --- Ingestion tuning ---
POLL_INTERVAL_SECONDS=2400    # how often to poll channels (2400 = 40 min)
TURSO_DEAL_RETENTION_DAYS=5     # Turso auto-deletes deals this many days after first saved; 0 = keep forever
DEAL_TTL_HOURS=96            # 4 days; live links get extended past this
BACKFILL_LIMIT=120            # messages pulled on a channel's first fetch
INCREMENTAL_LIMIT=60          # messages pulled per poll thereafter
MAX_CHANNELS_PER_USER=40
LIVENESS_CHECK=true           # probe deal links, retire dead/out-of-stock ones
LIVENESS_BATCH=40
QUALITY_FILTER=true           # only single-product posts with a price, store link and photo become cards
BROADCAST_HOT_DEAL=true       # push the best live deals (women's items first) to every device, no opt-in needed
BROADCAST_MIN_SCORE=30        # 0-100; a deal must score at least this to be pushed at all
PUSHES_PER_CYCLE=2            # hot-deal pushes per ingest cycle, each at a random moment inside it
PUSH_QUIET_HOURS=23-8         # IST hours with no pushes ("" = push around the clock)
NOTIFICATION_PITARA_ENABLED=true  # notification copy from app/content/notification_pitara*.json; false = built-in text

# --- Notification-copy writer (the model drafts new lines for review; switched on in the admin panel) ---
# Shares the GROQ_* key and daily budget with deal enrichment, so it takes a small slice and steps back first.
PITARA_WRITER_TOKENS_PER_DAY=12000   # its own ceiling per day
PITARA_WRITER_LEAVE_FREE_PCT=35      # no run once the shared budget is this % used (the rest is for enrichment)
PITARA_WRITER_LINES_PER_CALL=10
PITARA_WRITER_MAX_CALLS_PER_RUN=4
PITARA_WRITER_MAX_PENDING=120        # pause drafting while this many lines wait for review

# --- Promotion: /get?src=<label> sends Android visitors to the Play Store (label = install referrer) ---
PLAY_STORE_PACKAGE=com.tanush.dealradar
PLAY_STORE_URL=                       # optional: override the store page

# --- Keepalive ---
KEEPALIVE_ENABLED=false
KEEPALIVE_SECONDS=600

# --- Local ---
DB_PATH=data/deals.db
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# --- Public mode (optional): no user sign-in; the server's own account reads
# these public channels. Generate the session with: python tools/make_session.py
TELEGRAM_SESSION=
PUBLIC_CHANNELS=
